# Server Configuration
PORT=3000
NODE_ENV=production

# Public API & App URLs (For client-side API requests & Socket connections)
VITE_API_URL=https://syncstream.onrender.com
APP_URL=https://syncstream.onrender.com

# Database Integration (Optional: e.g. Supabase, Firebase, or PostgreSQL)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Gemini AI Key (Optional: Server-side secret)
GEMINI_API_KEY=your-gemini-api-key-here

